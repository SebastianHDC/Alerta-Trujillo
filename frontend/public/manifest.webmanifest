{
  "id": "/",
  "name": "Alerta Trujillo",
  "short_name": "Alerta Trujillo",
  "description": "Consulta, reporta y valida incidencias urbanas en la provincia de Trujillo.",
  "lang": "es-PE",
  "start_url": "/#/mapa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0d3a6b",
  "theme_color": "#0d3a6b",
  "categories": ["navigation", "news", "utilities"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Reportar incidencia", "short_name": "Reportar", "url": "/#/reportar", "icons": [{ "src": "/icons/shortcut-report.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Alertas cerca de mí", "short_name": "Cerca de mí", "url": "/#/alertas", "icons": [{ "src": "/icons/shortcut-nearby.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Contactos de emergencia", "short_name": "Emergencias", "url": "/#/contactos", "icons": [{ "src": "/icons/shortcut-contacts.png", "sizes": "96x96", "type": "image/png" }] }
  ]
}
