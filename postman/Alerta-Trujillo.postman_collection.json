{
  "info": {
    "name": "Alerta Trujillo – Flujo de demostración",
    "description": "Ejecuta en orden sobre la base local de demostración (APP_MODE=demo). Postman conserva la cookie de sesión. Cada ejecución registra un vecino nuevo, envía un reporte y lo lleva por revisión, validación y verificación.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "citizen_email",
      "value": ""
    },
    {
      "key": "citizen_dni",
      "value": ""
    },
    {
      "key": "citizen_password",
      "value": "VecinoPostman26!"
    },
    {
      "key": "moderator_email",
      "value": "moderador@example.com"
    },
    {
      "key": "moderator_password",
      "value": "ModeradorDemo26!"
    },
    {
      "key": "incident_time",
      "value": ""
    },
    {
      "key": "report_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Comprobar API",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));",
              "pm.test('Modo demo', () => pm.expect(pm.response.json().mode).to.eql('demo'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Alerta-Client",
            "value": "1"
          }
        ],
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "Consultar alertas públicas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));",
              "pm.test('La vista pública no expone el texto original ni la referencia exacta', () => {",
              "  pm.response.json().forEach((alert) => { pm.expect(alert).to.not.have.property('location'); pm.expect(['community','verified']).to.include(alert.status); });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Alerta-Client",
            "value": "1"
          }
        ],
        "url": "{{base_url}}/alerts?hours=720"
      }
    },
    {
      "name": "Registrar vecino de prueba",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = Date.now().toString();",
              "pm.collectionVariables.set('citizen_email', `vecino.${id}@example.com`);",
              "pm.collectionVariables.set('citizen_dni', id.slice(-8));",
              "pm.collectionVariables.set('incident_time', new Date(Date.now() - 3600000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 201', () => pm.response.to.have.status(201));",
              "pm.test('Rol ciudadano y sin documento en la respuesta', () => { const body = pm.response.json(); pm.expect(body.role).to.eql('citizen'); pm.expect(body).to.not.have.property('document_number'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Alerta-Client",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nickname\": \"Vecino Postman\",\n  \"email\": \"{{citizen_email}}\",\n  \"password\": \"{{citizen_password}}\",\n  \"document_type\": \"dni\",\n  \"document_number\": \"{{citizen_dni}}\",\n  \"district\": \"Trujillo\",\n  \"accept_terms\": true\n}"
        }
      }
    },
    {
      "name": "Enviar reporte",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 201', () => pm.response.to.have.status(201));",
              "const report = pm.response.json();",
              "pm.collectionVariables.set('report_id', report.id);",
              "pm.test('Entra en revisión', () => pm.expect(report.status).to.eql('pending'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Alerta-Client",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/reports",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"iluminacion\",\n  \"district\": \"Trujillo\",\n  \"location\": \"Cruce de prueba en el Centro Histórico\",\n  \"description\": \"Prueba de Postman: luminarias apagadas en una vía transitada.\",\n  \"latitude\": -8.1116,\n  \"longitude\": -79.0288,\n  \"occurred_at\": \"{{incident_time}}\"\n}"
        }
      }
    },
    {
      "name": "El reporte pendiente no es público",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Alerta-Client",
            "value": "1"
          }
        ],
        "url": "{{base_url}}/alerts/{{report_id}}"
      }
    },
    {
      "name": "Consultar mis reportes",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));",
              "pm.test('Incluye el reporte enviado', () => pm.expect(pm.response.json().map((r) => r.id)).to.include(pm.collectionVariables.get('report_id')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Alerta-Client",
            "value": "1"
          }
        ],
        "url": "{{base_url}}/reports/mine"
      }
    },
    {
      "name": "Un vecino no accede a la cola del equipo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Alerta-Client",
            "value": "1"
          }
        ],
        "url": "{{base_url}}/staff/queue"
      }
    },
    {
      "name": "Cerrar sesión vecinal",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Alerta-Client",
            "value": "1"
          }
        ],
        "url": "{{base_url}}/auth/logout"
      }
    },
    {
      "name": "Entrar como moderador de demostración",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));",
              "pm.test('Rol de moderación', () => pm.expect(pm.response.json().role).to.eql('moderator'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Alerta-Client",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{moderator_email}}\",\n  \"password\": \"{{moderator_password}}\"\n}"
        }
      }
    },
    {
      "name": "Ver cola de revisión",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));",
              "pm.test('El reporte está en la cola', () => pm.expect(pm.response.json().map((r) => r.id)).to.include(pm.collectionVariables.get('report_id')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Alerta-Client",
            "value": "1"
          }
        ],
        "url": "{{base_url}}/staff/queue"
      }
    },
    {
      "name": "No se publica sin la lista de control",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 422', () => pm.response.to.have.status(422));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Alerta-Client",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/staff/reports/{{report_id}}/screening",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"decision\": \"publish\",\n  \"note\": \"Prueba sin lista de control\",\n  \"risk\": \"medium\",\n  \"public_summary\": \"Luminarias apagadas en el Centro Histórico, por la noche.\",\n  \"checklist\": []\n}"
        }
      }
    },
    {
      "name": "Publicar como «Sin verificar»",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));",
              "pm.test('Pasa a validación vecinal', () => pm.expect(pm.response.json().status).to.eql('community'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Alerta-Client",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/staff/reports/{{report_id}}/screening",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"decision\": \"publish\",\n  \"note\": \"Sin datos sensibles\",\n  \"risk\": \"medium\",\n  \"public_summary\": \"Luminarias apagadas en el Centro Histórico, por la noche.\",\n  \"checklist\": [\n    \"sin_nombres\",\n    \"sin_domicilios\",\n    \"sin_acusaciones\",\n    \"no_emergencia\"\n  ]\n}"
        }
      }
    },
    {
      "name": "La alerta pública muestra solo el resumen",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));",
              "const alert = pm.response.json();",
              "pm.test('Resumen de moderación y sin referencia exacta', () => { pm.expect(alert.description).to.include('Centro Histórico'); pm.expect(alert).to.not.have.property('location'); });",
              "pm.test('Hora redondeada', () => pm.expect(new Date(alert.occurred_at).getUTCMinutes()).to.eql(0));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Alerta-Client",
            "value": "1"
          }
        ],
        "url": "{{base_url}}/alerts/{{report_id}}"
      }
    },
    {
      "name": "El equipo no vota",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "X-Alerta-Client",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/alerts/{{report_id}}/vote",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"answer\": \"yes\"\n}"
        }
      }
    },
    {
      "name": "Verificar la alerta",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));",
              "pm.test('Verificada', () => pm.expect(pm.response.json().status).to.eql('verified'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Alerta-Client",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/staff/reports/{{report_id}}/decision",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"decision\": \"verified\",\n  \"note\": \"Confirmada con el contexto disponible\"\n}"
        }
      }
    },
    {
      "name": "La decisión final es única",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Alerta-Client",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/staff/reports/{{report_id}}/decision",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"decision\": \"discarded\",\n  \"note\": \"Intento duplicado\"\n}"
        }
      }
    },
    {
      "name": "Consultar dashboard gerencial",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));",
              "pm.test('Incluye indicadores de conocimiento', () => pm.expect(pm.response.json()).to.have.property('knowledge'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Alerta-Client",
            "value": "1"
          }
        ],
        "url": "{{base_url}}/staff/dashboard"
      }
    },
    {
      "name": "Consultar base de conocimiento",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Alerta-Client",
            "value": "1"
          }
        ],
        "url": "{{base_url}}/staff/knowledge"
      }
    },
    {
      "name": "Cerrar sesión del moderador",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-Alerta-Client",
            "value": "1"
          }
        ],
        "url": "{{base_url}}/auth/logout"
      }
    }
  ]
}
